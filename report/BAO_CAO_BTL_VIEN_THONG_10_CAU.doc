line-height:150%;color:rgb(0,0,0);font-size:14.0000pt;" >-- SCRIPT PIG LATIN T&#7888;I &#431;U TR&#202;N HADOOP 3 SET default_parallel 1; -- 1. LOAD D&#7918; LI&#7878;U V&#7898;I SCHEMA &#272;&#7846;Y &#272;&#7910; raw_events = LOAD '/telecom/raw/batch_kpi/network_kpi_events.csv' USING PigStorage(',') AS (event_id: chararray, timestamp: chararray, tower_id: chararray, cell_id: chararray, technology: chararray, throughput_mbps: double, latency_ms: double, packet_loss_pct: double, call_dropped: int, num_active_users: int, signal_strength_dbm: double, error_code: chararray); bts_catalog = LOAD '/telecom/curated/dimension/bts_towers.csv' USING PigStorage(',') AS (tower_id: chararray, tower_name: chararray, province: chararray, district: chararray, latitude: double, longitude: double, install_date: chararray); -- 2. FILTER L&#192;M S&#7840;CH V&#192; LO&#7840;I D&#210;NG TI&#202;U &#272;&#7872; valid_events = FILTER raw_events BY (event_id != 'event_id') AND (tower_id IS NOT NULL) AND (latency_ms &gt;= 0.0) AND (throughput_mbps &gt;= 0.0) AND (packet_loss_pct &gt;= 0.0 AND packet_loss_pct &lt;= 100.0); ev_clean = FOREACH valid_events GENERATE event_id, tower_id, cell_id, technology, throughput_mbps, latency_ms, packet_loss_pct, call_dropped; bts_clean = FOREACH bts_catalog GENERATE tower_id, tower_name, province, district; -- 3. JOIN N&#7888;I S&#7920; KI&#7878;N V&#7898;I DANH M&#7908;C TR&#7840;M events_with_bts = JOIN ev_clean BY tower_id, bts_clean BY tower_id; -- 4. GROUP BY &#272;A CHI&#7872;U THEO TR&#7840;M V&#192; C&#212;NG NGH&#7878; grouped_kpi = GROUP events_with_bts BY (ev_clean::tower_id, ev_clean::technology, bts_clean::province, bts_clean::district); -- 5. FOREACH T&#205;NH C&#193;C H&#192;M T&#7892;NG H&#7906;P (COUNT, AVG, MAX, SUM, CONCAT) kpi_summary = FOREACH grouped_kpi GENERATE group.$0 AS tower_id: chararray, group.$1 AS technology: chararray, group.$2 AS province: chararray, group.$3 AS district: chararray, CONCAT(group.$0, '_', group.$1) AS tower_tech_code: chararray, COUNT(events_with_bts) AS sample_count: long, AVG(events_with_bts.ev_clean::throughput_mbps) AS mean_throughput_mbps: double, AVG(events_with_bts.ev_clean::latency_ms) AS mean_latency_ms: double, MAX(events_with_bts.ev_clean::packet_loss_pct) AS max_packet_loss_pct: double, SUM(events_with_bts.ev_clean::call_dropped) AS dropped_calls_count: int, ((double)SUM(events_with_bts.ev_clean::call_dropped) * 100.0 / (double)COUNT(events_with_bts)) AS call_drop_rate_pct: double; -- 6. SPLIT PH&#194;N NH&#193;NH TR&#7840;M SUY GI&#7842;M V&#192; TR&#7840;M B&#204;NH TH&#431;&#7900;NG SPLIT kpi_summary INTO degraded_cells IF (mean_latency_ms &gt; 80.0 OR call_drop_rate_pct &gt; 2.0 OR max_packet_loss_pct &gt; 5.0), normal_cells OTHERWISE; -- 7. TOP 10 NGUY C&#7844;P: D&#217;NG NESTED ORDER TRONG FOREACH &#272;&#7874; TR&#193;NH TOTALORDERPARTITIONER HADOOP 3 grouped_degraded = GROUP degraded_cells ALL; top_10_worst_cells = FOREACH grouped_degraded { sorted = ORDER degraded_cells BY call_drop_rate_pct DESC; top10 = LIMIT sorted 10; GENERATE FLATTEN(top10); }; -- 8. STORE K&#7870;T QU&#7842; V&#192;O HDFS STORE top_10_worst_cells INTO '/telecom/output/alerts/top_10_worst_cells' USING PigStorage(','); STORE normal_cells INTO '/telecom/output/reports/healthy_cells_kpi' USING PigStorage(','); </span><span class="18"  style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
